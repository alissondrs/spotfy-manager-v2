# ===== Geral =====
APP_ENV=development
LOG_LEVEL=INFO

# Segredo JWT compartilhado (OBRIGATÓRIO trocar em produção/compartilhado)
JWT_SECRET=dev-secret-please-change-1234567890-abcdefghijklmnopqrstuvwxyz
JWT_TTL_MINUTES=480
JWT_ALLOW_INSECURE_FOR_DEV=0
IDENTITY_ENABLE_BOOTSTRAP=0

# Diretório de dados (SQLite) por serviço
DATA_DIR=./data

# ===== Catálogo (Tidal via hifi-api) =====
# Modo mock: gera catálogo determinístico local (sem Tidal). Use "1" para demo/testes.
TIDAL_MOCK=1
# URL do hifi-api externo (formato legado). Em modo real, remova TIDAL_MOCK.
#HIFI_API_URL=http://127.0.0.1:3200

# ===== Spotify (playlist service) =====
# Opção 1: token de acesso direto
SPOTIFY_ACCESS_TOKEN=
# Opção 2: fluxo client-credentials (playlists públicas precisam de refresh manual via /auth/spotify)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ===== Downloads (library) =====
# Obrigatório para permitir download REAL (deixa "0" para validar em dry-run)
ALLOW_DOWNLOADS=0
DOWNLOAD_DIR=./downloads
# TTL (minutos) de validade do dry-run antes da confirmação do download
DRYRUN_TTL_MINUTES=15

# ===== URLs dos serviços (usado fora do docker compose) =====
IDENTITY_URL=http://127.0.0.1:8101
FILEIMPORT_URL=http://127.0.0.1:8102
PLAYLIST_URL=http://127.0.0.1:8103
CATALOG_URL=http://127.0.0.1:8104
BPM_MATCH_URL=http://127.0.0.1:8105
LIBRARY_URL=http://127.0.0.1:8106
REPORT_URL=http://127.0.0.1:8107

# ===== Web =====
WEB_URL=http://127.0.0.1:8000

# ===== Grafana (somente com `--profile grafana`) =====
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin