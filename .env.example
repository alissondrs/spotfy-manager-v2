# ===== Geral =====
APP_ENV=development
LOG_LEVEL=INFO

# Segredo JWT compartilhado (OBRIGATÓRIO trocar em produção/compartilhado)
JWT_SECRET=dev-secret-please-change-1234567890-abcdefghijklmnopqrstuvwxyz
JWT_TTL_MINUTES=480
JWT_ALLOW_INSECURE_FOR_DEV=0
IDENTITY_ENABLE_BOOTSTRAP=0

# Diretório de dados (SQLite) por serviço
DATA_DIR=./data

# ===== Catálogo (Tidal via hifi-api) =====
# Modo mock: gera catálogo determinístico local (sem Tidal). Use "1" para demo/testes.
TIDAL_MOCK=1
# URL do hifi-api externo (formato legado). Em modo real, remova TIDAL_MOCK.
#HIFI_API_URL=http://127.0.0.1:3200

# ===== Spotify =====
# OAuth Authorization Code + PKCE (S256) — o BFF gerencia code_verifier e refresh.
# Registre o app em https://developer.spotify.com/dashboard e adicione o redirect abaixo.
SPOTIFY_CLIENT_ID=
# URLs padrão compatíveis (troque apenas se apontar para um proxy/fake em testes):
#SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
#SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
#SPOTIFY_API_URL=https://api.spotify.com
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
SPOTIFY_SCOPES=user-library-read playlist-read-private playlist-read-collaborative
# Fallback legado (só via X-Spotify-Token do BFF; sem prioridade): token fixo de acesso
SPOTIFY_ACCESS_TOKEN=

# ===== Sessão anônima (web BFF) =====
# Sempre "1" em produção (exige __Host-bpm_session e HTTPS). Em dev local use "0".
WEB_SESSION_COOKIE_SECURE=0
WEB_SESSION_COOKIE_SAMESITE=lax
WEB_SESSION_IDLE_TTL_SECONDS=2592000
WEB_SESSION_ABSOLUTE_TTL_SECONDS=15552000
WEB_OAUTH_STATE_TTL_SECONDS=600
WEB_INTERNAL_JWT_TTL_MINUTES=5
# Chave Fernet em base64url (32 bytes) para cifrar tokens e code_verifier em repouso.
# Gere com:  python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# OBRIGATÓRIA em produção (App env != development). Em dev, se vazia, uma chave é
# gerada e salva em <DATA_DIR>/web_encryption.key.
WEB_TOKEN_ENCRYPTION_KEY=

# ===== Downloads (library) =====
# Obrigatório para permitir download REAL (deixa "0" para validar em dry-run)
ALLOW_DOWNLOADS=0
DOWNLOAD_DIR=./downloads
# TTL (minutos) de validade do dry-run antes da confirmação do download
DRYRUN_TTL_MINUTES=15

# ===== URLs dos serviços (usado fora do docker compose) =====
IDENTITY_URL=http://127.0.0.1:8101
FILEIMPORT_URL=http://127.0.0.1:8102
PLAYLIST_URL=http://127.0.0.1:8103
CATALOG_URL=http://127.0.0.1:8104
BPM_MATCH_URL=http://127.0.0.1:8105
LIBRARY_URL=http://127.0.0.1:8106
REPORT_URL=http://127.0.0.1:8107

# ===== Web =====
WEB_URL=http://127.0.0.1:8000

# ===== Grafana (somente com `--profile grafana`) =====
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin